# DylanBoard environment variables
# Copy this file to .env and fill in real values for local development.
# In production, set these in Netlify → Site configuration → Environment variables.
# Never commit .env to git.

# ── Required ──────────────────────────────────────────────────────────────────

# Password Dylan (and the Pi) use to log into the board.
BOARD_PASSWORD=

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=


# ── Stocks (Finnhub) ──────────────────────────────────────────────────────────
# Free tier at finnhub.io → Dashboard → API Keys.
# Without this, stock prices and S&P card show dashes. S&P sparklines still
# work (they use Yahoo Finance, which needs no key).
FINNHUB_KEY=


# ── Google OAuth client (shared by Nest + Google Tasks) ───────────────────────
# One Google Cloud project covers both integrations.
# console.cloud.google.com → APIs & Services → Credentials → Create OAuth 2.0 Client ID.
# Application type: Web application. Add an authorized redirect URI for your OAuth helper.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ── Nest thermostats (Google Smart Device Management API) ─────────────────────
# Requires a one-time $5 fee at console.nest.google.com to register a Device Access project.
# After paying, complete the OAuth consent flow to get a refresh token.
# Without these, the thermostat card shows dashes (graceful degradation).
NEST_REFRESH_TOKEN=
NEST_PROJECT_ID=


# ── Google Tasks (To Do widget) ───────────────────────────────────────────────
# Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET from above.
# Run the OAuth consent flow with scope: https://www.googleapis.com/auth/tasks.readonly
# Save the resulting refresh token below.
# Without this, the To Do card is empty (graceful degradation).
GOOGLE_TASKS_REFRESH_TOKEN=
# Optional: specific list ID. Defaults to @default (the first list).
# Find list IDs at: https://tasks.googleapis.com/tasks/v1/users/@me/lists
GOOGLE_TASKS_LIST_ID=


# ── iCloud shared album (photo slideshow) ─────────────────────────────────────
# Share an iCloud album (Photos → select album → Share → Copy Link).
# The token is the part after the # in the share URL.
# Example: https://www.icloud.com/photos/#B0123456789abcdef  →  token = B0123456789abcdef
# Without this, the photos tile is blank (graceful degradation).
ICLOUD_ALBUM_TOKEN=


# ── Blink camera ──────────────────────────────────────────────────────────────
# Blink credentials are NOT stored here. Dylan logs in through /admin.html,
# which uses the full OAuth v2 PKCE flow and stores tokens in Netlify Blobs.
# No env vars needed for Blink.
